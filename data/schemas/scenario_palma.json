{
  "name": "palma",
  "version": "0.1",

  "simulation": {
    "start_time":               "2022-02-08 00:00:00",
    "end_time":                 "2022-02-08 23:59:59",
    "sync_window_s":            30.0,
    "reroute_thresh":           0.20,
    "reroute_interval_s":       300.0,
    "stuck_threshold_ratio":    20.0,
    "teleport_interval_s":      300.0,
    "max_reroutes":             10,
    "stuck_max_hours":          4.0,
    "num_threads":              0,
    "store_traces":             false,
    "traffic_model":            "queue",
    "router":                   "CH",
    "snapshot_interval_s":      900
  },

  "network": {
    "osm_pbf":           "data/osm/palma_de_mallorca_fua.osm.pbf",
    "graph_bin":         "data/palma_de_mallorca/graph.bin",
    "simplify_topology": true,
    "extract_transit":   false
  },

  "routing": {
    "algorithm":            "CH",
    "preprocess_ch":        true,
    "ch_cache":             "data/palma_de_mallorca/ch.bin",
    "cache_entries":        500000,
    "use_traffic_costs":    true,
    "randomization_sigma":  0.08
  },

  "traffic": {
    "model": "queue"
  },

  "demand": {
    "source":       "od_csv",
    "od_csv":       "data/palma_de_mallorca/od_palma_de_mallorca_weekday.csv",
    "modes":        ["car"],
    "demand_scale": 0.75
  },

  "mode_choice": {
    "model":             "MNL",
    "multimodal":        false,
    "walk_speed_ms":     1.39,
    "bike_speed_ms":     4.17,
    "max_walk_access_m": 800.0,
    "vot_eur_per_hour":  12.0,
    "mnl": {
      "asc_car":      0.0,
      "asc_bike":    -0.5,
      "asc_walk":    -0.8,
      "asc_transit": -0.3,
      "beta_time":   -0.015,
      "beta_cost":   -0.20
    }
  },

  "output": {
    "output_dir":          "results/palma_de_mallorca",
    "writers":             ["geojson"],
    "snapshot_interval_s": 900,
    "store_trajectories":  false,
    "store_link_stats":    true
  }
}
